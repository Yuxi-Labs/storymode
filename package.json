{
  "name": "@yuxilabs/storymode-core",
  "version": "0.2.2",
  "description": "Core SDK for StoryMode DSL: lexing, parsing, AST, diagnostics.",
  "license": "MIT",
  "type": "module",
  "main": "dist/storymodeIndex.js",
  "types": "dist/storymodeIndex.d.ts",
  "exports": {
    ".": {
      "types": "./dist/storymodeIndex.d.ts",
      "default": "./dist/storymodeIndex.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
