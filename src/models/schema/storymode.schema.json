{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://storymode.dev/schema/storymode.schema.json",
  "title": "StoryMode DSL Schema",
  "description": "Unified schema for StoryMode story and narrative parsed objects.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/story" },
    { "$ref": "#/$defs/narrative" }
  ],
  "$defs": {
  "id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]+$" },
    "cue": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["sfx","music","vfx"] },
        "items": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 0 },
        "line": { "type": "number" },
        "column": { "type": "number" }
      },
      "required": ["type","items"],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "variantOf": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true },
        "cues": { "type": "array", "items": { "$ref": "#/$defs/cue" }, "minItems": 0 },
        "line": { "type": "number" },
        "endLine": { "type": ["number","null"] }
      },
      "required": ["id","metadata","cues","line"],
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string", "enum": ["error","warning","info"] },
        "file": { "type": "string" },
        "line": { "type": "number" },
        "column": { "type": "number" }
      },
      "required": ["code","message","severity","file","line","column"],
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "files": {
          "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
        },
        "metadata": { "type": "object", "additionalProperties": true },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      },
      "required": ["id","files","metadata","diagnostics"],
      "additionalProperties": true
    },
    "narrative": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" }, "minItems": 0 },
        "metadata": { "type": "object", "additionalProperties": true },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      },
      "required": ["id","scenes","metadata","diagnostics"],
      "additionalProperties": true
    }
  }
}